# Vercel CLI 不继承 .gitignore，上传时显式保持相同的本地文件边界。

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
chat-questions.local.jsonl
.local/

# local planning and private docs
/docs/
/findings.md
/progress.md
/task_plan.md
/AGENTS.md
/CLAUDE.md
/.codex/
/.agents/

# env files
.env*

# vercel
.vercel

# supabase
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts
